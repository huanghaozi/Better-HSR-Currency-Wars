<Window x:Class="HsrCurrencyWarsCleanWpf.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V13.43 更新内容"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="TextBrush" Color="#1B2230" />
    <SolidColorBrush x:Key="MutedBrush" Color="#68768A" />
    <SolidColorBrush x:Key="LineBrush" Color="#B7CDE3" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#5FAFE6" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#529FDC" />
    <Style x:Key="RoundedButton" TargetType="Button">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="11">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="18" CornerRadius="18" Background="#F7FBFF" BorderBrush="#BED3E7" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="5" Direction="270" Opacity="0.22" Color="#60758A" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="66" />
        <RowDefinition Height="*" />
        <RowDefinition Height="78" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#EEF7FD" CornerRadius="18,18,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="22,0,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="38" />
          </Grid.ColumnDefinitions>
          <Image Source="Assets/app.ico" Width="38" Height="38" Stretch="Uniform" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Better HSR-Currency Wars" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="欢迎使用 V13.43" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
          </StackPanel>
          <Button Grid.Column="2" Content="×" Click="Close_Click" Width="32" Height="32" FontSize="22" Foreground="#68768A" Background="Transparent" BorderThickness="0" Cursor="Hand" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="26,18,20,8">
        <StackPanel>
          <TextBlock Text="本次更新" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" Margin="0,0,0,14" />

          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="26" CornerRadius="13" Background="#DDF2FC" VerticalAlignment="Top">
                <TextBlock Text="V13.43" Foreground="#315C80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="投资流程全面改为 OCR 驱动" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="投资确认改用 OCR 识别「确认」按钮；投资卡片 OCR 定位标题后点击；识别不到才用固定坐标。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="移除无条件盲点" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="删除「蓝海二段」2 轮盲点，改为按页面状态判断是否需要二次投资，避免在正常流程里点错位置。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="状态机接管关键判断" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="返回首页、等待棋盘、等待词条页均改用页面状态判断；词条页「下一步」恢复 OCR 优先。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="26" CornerRadius="13" Background="#DDF2FC" VerticalAlignment="Top">
                <TextBlock Text="V13.42" Foreground="#315C80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="OCR 引擎全面升级" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="改用 RapidOcrNet + PP-OCRv6 small，识别率与速度大幅提升，同时移除 Python 运行时，安装包体积减少约 50MB。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="页面状态识别" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="通过文字锚点判断当前处于哪个页面，新增“诊断当前页面”按钮可查看识别得分与候选状态。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="校验与等待机制" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="点击后改用画面差异正向校验，修复“点了没反应却判定成功”；投资识别等待动画播完再扫描，修复投资环境被跳过。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="26" CornerRadius="13" Background="#DDF2FC" VerticalAlignment="Top">
                <TextBlock Text="V13.41" Foreground="#315C80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="云游戏画面区域识别" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="新增游戏画面区域检测：自动识别云游戏客户端的标题栏、导航栏与画面黑边，点击和 OCR 全部基于真实游戏画面计算。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="修复左上角退出按钮点击失效" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="云游戏窗口的标题栏位于客户区内部，原先固定比例坐标会落在标题栏上。修复后退出结算可以正常识别并点击。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="画面内缩手动校准" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="新增自动检测开关、四方向内缩输入框和“诊断画面区域”按钮，自动识别不准时可手动校准。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="26" CornerRadius="13" Background="#DDF2FC" VerticalAlignment="Top">
                <TextBlock Text="V13.1" Foreground="#315C80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="桌面分身界面焕新" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="重新设计标题、连接状态、操作按钮和分身画面区域，同时保留关闭窗口自动注销功能。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="Mirror酱版本检测" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="优先通过 Mirror酱检查版本，失败时自动回退 GitHub；更新窗口新增可保存的 Mirror酱 CDK。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="移除腾讯云 COS" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="删除已停用的 COS 检查与下载逻辑，继续保留 GitHub Velopack 增量更新和百度网盘完整修复入口。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="26" CornerRadius="13" Background="#DDF2FC" VerticalAlignment="Top">
                <TextBlock Text="V12.7" Foreground="#315C80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="自动战斗固定图标识别" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="改为匹配左下角明确的“自动战斗关闭”固定图标，只有相似度达到要求才按 V。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="降低状态误判" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="移除右上角黄色与灰白像素比例判断，并在战斗过程中持续复查，减少特效、亮度、缩放及副屏造成的误判。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>

		  <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,12">
			<Grid>
			  <Grid.ColumnDefinitions>
				<ColumnDefinition Width="62" />
				<ColumnDefinition Width="*" />
			  </Grid.ColumnDefinitions>
			  <Border Width="48" Height="26" CornerRadius="13" Background="#DDF2FC" VerticalAlignment="Top">
				<TextBlock Text="V12.6" Foreground="#315C80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
			  </Border>
			  <StackPanel Grid.Column="1">
				<TextBlock Text="蓝海兜底顺序修正" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
				<TextBlock Text="正常选择投资卡并完成底部固定确认后，再执行蓝海二段固定点位兜底，避免在确认前改动已经选中的投资。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
				<TextBlock Text="减少固定兜底点击" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
				<TextBlock Text="普通局外、独立局内与局外+局内统一执行顺序，固定兜底由 4 轮缩短为 2 轮。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,0" />
			  </StackPanel>
			</Grid>
		  </Border>

          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="26" CornerRadius="13" Background="#DDF2FC" VerticalAlignment="Top">
                <TextBlock Text="V12.5" Foreground="#315C80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="投资与策略自定义优先级" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="投资目标和局内策略支持上移、下移；同时识别到多个目标时，优先选择列表中靠上的项目。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="配置界面紧凑化" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="缩小局外、局内及组合流程的投资和策略控件，保留原字体大小。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="26" CornerRadius="13" Background="#DDF2FC" VerticalAlignment="Top">
                <TextBlock Text="V12.4" Foreground="#315C80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="开局流程加速" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="前三页改为共同固定点位连续点击 3.5 秒，结束后直接开始主词条 OCR，减少重复全屏识别。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="结算返回加速" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="识别到“下一步”后立即固定连点 6 次，不再分别等待“下一页”和“返回货币战争”。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="恢复旧版蓝海固定兜底" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="普通局外投资未命中目标时，恢复中间选项与确认按钮固定点来回点击 4 轮。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="48" Height="26" CornerRadius="13" Background="#DDF2FC" VerticalAlignment="Top">
                <TextBlock Text="V12.3" Foreground="#315C80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="副屏与缩放兼容" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="新增副屏截图与每显示器 DPI 适配，完善副屏环境下的 OCR、点击和窗口坐标。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="慢速流程与自动战斗优化" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="大步骤会确认目标下一页后再继续；优化自动战斗图标亮暗判断，减少网络较慢或缩放环境下的误判。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="投资与策略选择完善" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="忽略投资目标时仍会避开蓝海与特殊专家；可设置未命中投资也进局，并优先选择图鉴未收录的投资或策略。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,9" />
                <TextBlock Text="稳定性细节" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="完善备战角色拖拽、OCR 长时间运行维护、日志上限及结算返回流程。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="#FFF8F3" BorderBrush="#F3C9AE" BorderThickness="1" CornerRadius="12" Padding="14">
            <TextBlock Text="提示：运行工具时请右键程序，选择“以管理员身份运行”。" Foreground="#9B5A34" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" BorderBrush="#D5E3F0" BorderThickness="0,1,0,0" Background="White" CornerRadius="0,0,18,18">
        <Grid Margin="24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox x:Name="DoNotShowAgainBox" Content="本版本不再显示" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}" />
          <Button Grid.Column="1" Content="我知道了" Style="{StaticResource RoundedButton}" Click="Confirm_Click" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
